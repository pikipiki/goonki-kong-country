{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "vite/client",
      "vitest/globals",
      "node",
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": [
    "tests/**/*.ts",
    "tests/helpers/**/*.ts",
    "e2e/**/*.ts",
    "src/**/*.test.tsx",
    "src/test/**/*"
  ],
  "exclude": []
}
