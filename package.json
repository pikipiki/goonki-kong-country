{
  "name": "goonk-country",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "format": "eslint --fix src tests e2e .storybook eslint.config.js vite.config.ts playwright.config.ts; prettier --write src tests e2e .storybook package.json eslint.config.js vite.config.ts playwright.config.ts",
    "format:engine": "eslint --fix src/game/engine src/islandMap/travelerMotion.ts && prettier --write src/game/engine src/islandMap/travelerMotion.ts",
    "format:check": "prettier --check src tests e2e .storybook package.json eslint.config.js vite.config.ts playwright.config.ts",
    "test:all": "vitest run && npm run test:e2e && npm run test:functional",
    "test:functional": "node scripts/run-functional-tests.mjs",
    "lint": "npm run format:check && eslint . --max-warnings 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "GITHUB_PAGES=true npm run build && GITHUB_PAGES=true vite preview --host 0.0.0.0",
    "test": "vitest run --project game --project unit",
    "test:watch": "vitest --project game --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:coverage": "vitest run --project game --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sonar": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; npm run test:coverage && npx sonar-scanner -Dsonar.host.url=${SONAR_HOST_URL:-http://localhost:9000} ${SONAR_TOKEN:+-Dsonar.token=$SONAR_TOKEN}'",
    "analyze:rom": "python3 scripts/analyze_rom.py",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:mobile": "node scripts/mobile-browser.mjs",
    "analyze:buddies": "python3 scripts/analyze_buddies.py",
    "test:buddies": "node scripts/buddy-browser.mjs",
    "test:map": "node scripts/map-browser.mjs",
    "test:original": "node scripts/original-browser.mjs",
    "analyze:player": "python3 scripts/analyze_player_states.py",
    "analyze:audio": "python3 scripts/analyze_audio_rom.py",
    "analyze:levels": "python3 scripts/analyze_level_tables.py",
    "generate:jungle": "python3 scripts/generate_original_jungle.py",
    "generate:jungle-parity": "python3 scripts/generate_jungle_parity.py",
    "generate:coral": "python3 scripts/generate_original_coral.py",
    "generate:terrain": "python3 scripts/generate_original_terrain.py",
    "generate:coral-terrain": "python3 scripts/generate_original_coral_terrain.py",
    "generate:reverb": "python3 scripts/generate_original_reverb.py",
    "generate:reverb-parity": "python3 scripts/generate_reverb_parity.py",
    "generate:cave-terrain": "python3 scripts/generate_original_cave_terrain.py",
    "generate:mine-cart": "python3 scripts/generate_original_mine_cart.py",
    "generate:mine-cart-terrain": "python3 scripts/generate_original_mine_cart_terrain.py",
    "verify:rom": "python3 scripts/verify_rom_evidence.py",
    "relocate:pattern": "python3 scripts/relocate_rom_pattern.py",
    "analyze:necky": "python3 scripts/analyze_necky_ballistics.py",
    "probe:jungle": "python3 scripts/probe_jungle_extensions.py",
    "probe:coral": "python3 scripts/probe_coral_extensions.py",
    "generate:coral-parity": "python3 scripts/generate_coral_parity.py",
    "attempt:necky-bridge": "python3 scripts/attempt_jungle_necky_bridge.py",
    "analyze:audio-fidelity": "python3 scripts/analyze_audio_fidelity.py",
    "analyze:jungle-bonus": "python3 scripts/analyze_jungle_bonus_walls.py",
    "test:stages": "node scripts/stage-regressions-browser.mjs",
    "test:decor": "node scripts/visual-layers-browser.mjs",
    "analyze:coral-terrain": "python3 scripts/analyze_coral_terrain.py",
    "test:mechanics": "node scripts/mechanics-browser.mjs",
    "test:ground": "node scripts/ground-rendering-browser.mjs",
    "test:playthrough:canyon": "node scripts/playthrough-canyon.mjs",
    "test:playthrough:coral": "node scripts/playthrough-coral.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "i18next": "^26.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-storybook": "^10.6.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
